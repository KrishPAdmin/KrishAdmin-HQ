          "conditions": [
            {
              "id": "885a3e2d-5815-596d-b24a-7c6fa71325cf",
              "leftValue": "={{ typeof $json.prompt === 'string' && $json.prompt.trim().length > 0 && $json.prompt.length <= 12000 && ['fast','reasoning'].includes($json.tier) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "position": [
        460,
