      "name": "nvidia-gpu | Fast",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://192.0.2.181:11434/api/chat",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: 'qwen3:4b', messages: [{role: 'system', content: 'You are KrishAdmin-HQ, a local homelab assistant. Be accurate and concrete. Distinguish supplied evidence from assumptions. You only generate text; never claim to have inspected systems or executed actions.'}, {role:'user', content:$json.prompt}], stream:false, think:false, options:{num_ctx:8192,num_predict:768,temperature:0.2} }) }}",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [
        960,
        -80
